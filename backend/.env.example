# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/onlyalpha

# ─── Redis ────────────────────────────────────────────────────────────────────
# Optional — rate limiting + caching (remove to disable)
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_string_in_production
JWT_EXPIRES_IN=7d

# ─── OpenRouter ───────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
SEO_MODEL=openai/gpt-5-nano

# ─── BINNS (AI News Verification) ──────────────────────────────────────────
BINNS_SECRET_KEY=
BINNS_API_KEY=

# ─── GLM (Zhipu AI - Direct API) ────────────────────────────────────────────────
# Used for deep analysis (cheaper at scale than GLM-5)
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-plus
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ─── Binance (optional for authenticated requests) ────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET=

# ─── Moralis (Web3 wallet tracking) ──────────────────────────────────────────
MORALIS_API_KEY=

# ─── Alternative.me (Fear & Greed) ───────────────────────────────────────────
ALTERNATIVE_ME_URL=https://api.alternative.me/fng/

# ─── Next.js Cache Revalidation (optional) ────────────────────────────────────
NEXTJS_REVALIDATE_SECRET=
NEXTJS_BASE_URL=http://localhost:3000

# ─── Market Context / OnlyAlpha Insights (DEC-040 + DEC-043) ─────────────────
# Master switch (public hub, admin, generators, seed)
MARKET_CONTEXT_ENABLED=false
# News ingest cron (terminal/RSS/telegram → market_news_items)
MARKET_CONTEXT_INGEST_ENABLED=false
MARKET_CONTEXT_TELEGRAM_POLL_LIMIT=50
# DEC-043 auto-trust + full-auto coin pages
MARKET_CONTEXT_AUTO_TRUST_ENABLED=true
MARKET_CONTEXT_FULL_AUTO_COIN_ENABLED=true
MARKET_CONTEXT_SEMANTIC_DEDUP_THRESHOLD=0.88
MARKET_CONTEXT_AUTO_TRUST_MINOR_MIN_SCORE=60
MARKET_CONTEXT_AUTO_TRUST_MAJOR_MIN_SCORE=70
MARKET_CONTEXT_SEVERITY3_TIMEOUT_HOURS=6
# Seed drafts only (ops): FORCE_COIN_SEED=true npm run seed:coin-blog
